# Copie este arquivo para .env.local neste diretório antes de rodar o frontend no host:
#   cp .env.example .env.local
#
# Use estes valores quando o Next.js roda com `npm run dev` na máquina
# e a API está em http://localhost:3001 (Docker ou `npm run dev` em node/).
#
# No Docker Compose, o frontend NÃO usa este arquivo: as variáveis vêm do .env da raiz
# e do bloco `environment` do serviço `frontend`.
# Valores abaixo são de EXEMPLO para desenvolvimento local.

NEXT_PUBLIC_API_URL=http://localhost:3001
BACKEND_PORT=3001
FRONTEND_PORT=3000

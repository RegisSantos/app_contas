# Copie este arquivo para .env na raiz antes de executar o Docker Compose:
#   cp .env.example .env
#
# Valores abaixo são de EXEMPLO para desenvolvimento local.
# Não use estas credenciais em produção.

# Portas publicadas no host
BACKEND_PORT=3001
FRONTEND_PORT=3000

# MySQL (serviço docker-compose: mysql-v8)
# MYSQL_HOST deve ser o nome do serviço no Compose, não localhost.
MYSQL_HOST=mysql-v8
MYSQL_PORT=3306
MYSQL_DATABASE=app_contas
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_ROOT_PASSWORD=root

# RabbitMQ (serviço docker-compose: rabbitmq-v4)
RABBITMQ_HOST=rabbitmq-v4
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest

# Redis (serviço docker-compose: redis-v8)
REDIS_HOST=redis-v8

# Auth.js / sessão (altere em qualquer ambiente compartilhado ou produção)
AUTH_SECRET=dev-auth-secret-not-for-production

# Copie este arquivo para .env neste diretório antes de rodar o backend no host:
#   cp .env.example .env
#
# Use estes valores quando o backend roda com `npm run dev` / `npm start` na máquina
# e o MySQL, RabbitMQ e Redis estão no Docker (portas publicadas em localhost).
#
# No Docker Compose, o backend NÃO usa este arquivo: as variáveis vêm do .env da raiz.
# Valores abaixo são de EXEMPLO para desenvolvimento local.

PORT=3001

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=app_contas
MYSQL_USER=root
MYSQL_PASSWORD=root

RABBITMQ_HOST=localhost
REDIS_HOST=localhost

AUTH_SECRET=dev-auth-secret-not-for-production
FRONTEND_URL=http://localhost:3000
